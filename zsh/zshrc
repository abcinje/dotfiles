# ==============================================================
# Shell
# ==============================================================

# Oh My Zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="injae"

plugins=(
  git
  zoxide
  zsh-syntax-highlighting
)

source $ZSH/oh-my-zsh.sh

# Zsh
unsetopt hist_verify
setopt rmstarsilent
zstyle ":completion:*" insert-tab false

# Key Bindings
if [ $TERM = "xterm" ]; then
  bindkey "^[[1~" beginning-of-line
  bindkey "^[[4~" end-of-line
fi

# ==============================================================
# Editor
# ==============================================================

# Vim
alias view="vim -R"

# NeoVim
if [ $(uname) = "Darwin" ]; then
  export PATH="$PATH:/opt/nvim-macos-arm64/bin"
else
  export PATH="$PATH:/opt/nvim-linux-x86_64/bin"
fi
alias nv="nvim"

# ==============================================================
# Remote
# ==============================================================

# BMC
function bmc {
  if [ $# -ne 1 ]; then
    echo "Usage: bmc <host>"
    return 1
  fi

  local target="$1.bmc"
  local config proxyjump hostname
  config=$(ssh -G "$target" 2>/dev/null)
  proxyjump=$(echo "$config" | awk '$1 == "proxyjump" { print $2; exit }')
  hostname=$(echo "$config" | awk '$1 == "hostname" { print $2; exit }')
  if [ -z "$proxyjump" ] || [ -z "$hostname" ] || [ "$hostname" = "$target" ]; then
    echo "bmc: no entry for '$target' in ~/.ssh/config"
    return 1
  fi

  local session="bmc"
  local proxy="ssh -D localhost:8888 -N $proxyjump -v"
  local chrome
  if [ $(uname) = "Darwin" ]; then
    chrome="/Applications/Google\ Chrome.app/Contents/MacOS/Google\ Chrome --proxy-server=socks5://localhost:8888 https://$hostname"
  else
    chrome="/usr/bin/google-chrome --proxy-server=socks5://localhost:8888 https://$hostname"
  fi

  tmux new-session -d -s "$session"
  tmux send-keys -t "${session}:0.0" "$proxy" C-m
  tmux split-window -t "${session}:0"
  tmux send-keys -t "${session}:0.1" "$chrome" C-m
  tmux attach -t "$session"
}

# SSH
function sshloop {
  while true; do
    ssh "$@"
    if [ $? -eq 0 ]; then
      break
    fi
    sleep 2
  done
}

# ==============================================================
# System
# ==============================================================

# dmesg
alias dmesg="sudo dmesg"

# SysRq
function sysrq {
  sudo sh -c "echo $1 > /proc/sysrq-trigger"
}

# ==============================================================
# Misc
# ==============================================================

# Bat
if [ $(uname) = "Darwin" ]; then
  batname="bat"
else
  case $(lsb_release -is) in
    Debian|Ubuntu)
      batname="batcat"
      ;;
    *)
      batname="bat"
  esac
fi
export MANROFFOPT="-c" MANPAGER="sh -c 'col -bx | $batname -l man -p'"
alias bat="$batname --tabs=8"

# Cargo
if [ -d "$HOME/.cargo" ]; then
  . "$HOME/.cargo/env"
fi

# Claude
export PATH="$HOME/.local/bin:$PATH"

# ==============================================================
# Temp
# ==============================================================

if [ -f "$HOME/.zshrc.tmp" ]; then
  . "$HOME/.zshrc.tmp"
fi

